{
    "name": "furever/app",
    "description": "FurEver — animal shelter management system (custom PHP MVC).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "FurEver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FurEver\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
